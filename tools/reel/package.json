{
  "name": "zaytovnn-reel",
  "private": true,
  "description": "Polished 9:16 Reels for Zaytovnn Trades, built with Remotion (the claude-code-video-toolkit's renderer)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Reel005 ../../renders/reel/005-reel-captions.mp4",
    "render:clean": "remotion render Reel005 ../../renders/reel/005-reel-clean.mp4 --props='{\"captions\":false}'"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "remotion": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
